PORT=3000
NODE_ENV=development
SESSION_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
DATA_ENCRYPTION_KEY=change-this-to-a-separate-32-char-random-encryption-key

# Single Owner Account (Only 1 Owner allowed in the platform)
OWNER_NAME=مالك منصة OrderFlow
OWNER_EMAIL=owner@orderflow.eg
OWNER_PHONE=01099990000
OWNER_PASSWORD=change-owner-password-min-8-chars

# Optional Gemini AI API Key
GEMINI_API_KEY=

# External Payment Gateway (Kashier / Wallet)
# PAYMENT_PROVIDER=kashier
# KASHIER_MERCHANT_ID=MID-xxxx-xxx
# KASHIER_API_KEY=your-kashier-payment-api-key
# KASHIER_MODE=test
# KASHIER_ALLOWED_METHODS=wallet
# PAYMENT_WALLET_NUMBER=010xxxxxxxx

